# cl keeps its state outside the checkout — ~/.claude/launcher by default, or
# $CL_DATA_DIR — so a `git pull` never touches your pins, profiles or backups
# and the working tree stays clean. These entries only matter if you point
# CL_DATA_DIR at the repo itself.
state.json
backups/
archive/

# Scratch
*.tmp
*.log
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db
desktop.ini

# Account pointers, if ever written beside the code rather than in the state dir.
accounts.json
.credentials.json
.claude.json
