# Backups cl takes before writing a config file
backups/

# Runtime state: pins, profiles, last-used config. Rewritten on every launch,
# so tracking it would leave the repo permanently dirty. The launch profile and
# the eight hook presets it was seeded from are preserved in
# archive/presets.json, and `node migrate.mjs` re-imports them.
state.json

